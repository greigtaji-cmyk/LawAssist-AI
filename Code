def risk_flags(problem):
    p=norm(problem)
    flags=[]
    if any(x in p for x in ["child","minor","sexual","rape","abuse"]):
        flags.append("Potentially sensitive/high-stakes matter: obtain qualified legal assistance and protect identities.")
    if any(x in p for x in ["arrest","custody","jail","detained"]):
        flags.append("Potential liberty/custody issue: procedural timing may be important.")
    if any(x in p for x in ["deadline","notice","limitation","years ago"]):
        flags.append("Potential time-limit issue: verify limitation and commencement rules.")
    if any(x in p for x in ["court order","injunction","stay","contempt"]):
        flags.append("Potential court-order issue: preserve the exact order and compliance timeline.")
    return flags


def split_sentences(text):
    return [s.strip() for s in re.split(r'(?<=[.!?])\s+|\n+', text) if s.strip()]

def extract_entities(problem):
    """Lightweight local extraction; never claims these are legally verified facts."""
    text = problem
    people = re.findall(r'\b(?:Mr\.|Ms\.|Mrs\.|Dr\.)\s+[A-Z][A-Za-z]+(?:\s+[A-Z][A-Za-z]+){0,2}', text)
    money = re.findall(r'(?:₹|Rs\.?|INR)\s?[\d,]+(?:\.\d+)?', text, flags=re.I)
    emails = re.findall(r'[\w\.-]+@[\w\.-]+\.\w+', text)
    phones = re.findall(r'\b(?:\+91[-\s]?)?[6-9]\d{9}\b', text)
    return {
        "people_or_named_persons": list(dict.fromkeys(people)),
        "money_mentions": list(dict.fromkeys(money)),
        "emails": list(dict.fromkeys(emails)),
        "phones": list(dict.fromkeys(phones)),
        "dates": timeline(text),
        "sentences": split_sentences(text)
    }

def fact_classification(problem):
    """Classify sentences as allegation/fact/unknown based on cautious lexical signals."""
    rows=[]
    for s in split_sentences(problem):
        p=norm(s)
        if any(x in p for x in ["alleged", "claims", "claimed", "accused", "reportedly"]):
            label="ALLEGATION / CLAIM"
        elif any(x in p for x in ["may", "might", "possibly", "perhaps", "think", "believe"]):
            label="UNCERTAIN"
        else:
            label="FACT AS PROVIDED"
        rows.append((label,s))
    return rows

