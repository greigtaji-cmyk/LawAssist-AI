V10_RETRIEVAL_VERSION = "10"

V10_STOPWORDS = {
    "the","and","or","of","to","in","on","for","a","an","is","are","was","were",
    "with","that","this","from","by","as","at","be","has","have","had","it","its",
    "their","they","he","she","them","his","her","which","who","what","when","where",
    "how","why","then","than","into","over","under","after","before","about","there",
    "here","not","but","also","may","can","could","would","should","alleged","claims"
}

def v10_terms(text):
    words = re.findall(r"[A-Za-z][A-Za-z0-9_-]{2,}", (text or "").lower())
    return [w for w in words if w not in V10_STOPWORDS]

def v10_tfidf_like_score(query, text):
    # Explainable local relevance score. It is NOT a legal confidence score.
    q = Counter(v10_terms(query))
    d = Counter(v10_terms(text))
    if not q or not d:
        return 0.0
    overlap = sum(min(q[k], d[k]) for k in q if k in d)
    q_norm = math.sqrt(sum(v*v for v in q.values()))
    d_norm = math.sqrt(sum(v*v for v in d.values()))
    return round(overlap / (q_norm * d_norm), 4) if q_norm and d_norm else 0.0

def v10_rank_chunks(query, chunks, top_k=8):
    ranked = []
    for ch in chunks or []:
        text = ch.get("text", "")
        score = v10_tfidf_like_score(query, text)
        ranked.append({
            "chunk_id": ch.get("chunk_id", ""),
            "page_no": ch.get("page_no", 0),
            "text": text,
            "score": score,
            "source_sha256": ch.get("sha256", ""),
        })
    ranked.sort(key=lambda x: x["score"], reverse=True)
    for i, row in enumerate(ranked[:top_k], 1):
        row["rank"] = i
    return ranked[:top_k]

def v10_extract_events(problem):
    sentences = [normalize_text(x) for x in re.split(r"(?<=[.!?])\s+", problem or "") if normalize_text(x)]
    events = []
    for sentence in sentences:
        dates = extract_dates(sentence)
        if dates:
            for date in dates:
                events.append({
                    "date_text": date,
                    "event": sentence,
                    "status": classify_fact_status(sentence),
                })
    return events

def v10_chronology(problem):
    events = v10_extract_events(problem)
    # Keep original text ordering when date parsing is ambiguous.
    for i, event in enumerate(events, 1):
        event["sequence"] = i
    return events

def v10_find_gaps(problem):
    low = (problem or "").lower()
    gaps = []
    checks = [
        (["date", "on ", "202"], "Exact dates and sequence of material events"),
        (["contract", "agreement"], "Exact agreement/terms and any notice or cure provision"),
        (["payment", "paid", "amount", "refund"], "Amount, payment trail and transaction proof"),
        (["message", "email", "call", "whatsapp"], "Original communication records and context"),
        (["injury", "hurt", "hospital", "medical"], "Medical records and chronology"),
        (["company", "employer", "employee"], "Correct legal identity and role of each entity/person"),
    ]
    for keys, gap in checks:
        if any(k in low for k in keys):
