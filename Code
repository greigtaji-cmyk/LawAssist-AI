def search_index(problem, limit=10):
    create_documents_db()
    con=sqlite3.connect(DB)
    rows=con.execute("SELECT name,path,content,sha256 FROM documents").fetchall()
    con.close()
    scored=[]
    for name,path,content,digest in rows:
        score=tfidf_similarity(problem, content)
        if score > 0:
            scored.append((score,name,path,digest,content))
    return sorted(scored,key=lambda x:x[0],reverse=True)[:limit]

