def extract_text_file(path):
    """Read common text-like legal documents without external packages."""
    ext = Path(path).suffix.lower()
    if ext in {".txt", ".md", ".csv", ".json", ".py"}:
        return Path(path).read_text(encoding="utf-8", errors="ignore")
    if ext == ".docx":
        try:
            from docx import Document
            doc = Document(path)
            return "\n".join(p.text for p in doc.paragraphs)
        except Exception as e:
            raise RuntimeError("DOCX support requires python-docx.") from e
    if ext == ".pdf":
        try:
            from pypdf import PdfReader
            r = PdfReader(path)
            return "\n".join((p.extract_text() or "") for p in r.pages)
        except Exception as e:
            raise RuntimeError("PDF support requires pypdf.") from e
    raise RuntimeError("Supported formats: TXT, MD, CSV, JSON, DOCX and PDF.")

