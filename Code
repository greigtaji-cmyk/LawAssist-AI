def words(text):
    return re.findall(r"[a-zA-Z][a-zA-Z0-9_-]{2,}", norm(text))

def tfidf_similarity(a, b):
    """Small dependency-free cosine similarity for local document/case retrieval."""
    wa, wb = words(a), words(b)
    if not wa or not wb:
        return 0.0
    da, db = {}, {}
    for w in wa: da[w] = da.get(w, 0) + 1
    for w in wb: db[w] = db.get(w, 0) + 1
    vocab = set(da) | set(db)
    dot = sum(da.get(w, 0) * db.get(w, 0) for w in vocab)
    na = math.sqrt(sum(v*v for v in da.values()))
    nb = math.sqrt(sum(v*v for v in db.values()))
    return (dot / (na * nb) * 100) if na and nb else 0.0

def semantic_case_leads(problem):
    rows=[]
    for case in CASE_DB:
        text = " ".join([
            case["name"], case["court"], " ".join(case["tags"]), case["summary"]
        ])
        sim = tfidf_similarity(problem, text)
        if sim > 0:
            rows.append((sim, case))
    return sorted(rows, key=lambda x:x[0], reverse=True)

