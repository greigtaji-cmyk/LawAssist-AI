def detect_contradictions(problem):
    """Find simple direct contradictions for manual review; not a legal finding."""
    sentences=split_sentences(problem)
    findings=[]
    pairs=[
        (r"\bnot\b.*\bpaid\b", r"\bpaid\b"),
        (r"\bdid not\b.*\bmeet\b", r"\bmet\b"),
        (r"\bnever\b", r"\bsaid\b|\bcalled\b|\bmet\b"),
        (r"\bno\b.*\bcontract\b", r"\bcontract\b|\bagreement\b"),
        (r"\bno\b.*\bwitness\b", r"\bwitness\b|\bsaw\b|\bheard\b"),
    ]
    for i,a in enumerate(sentences):
        for j,b in enumerate(sentences[i+1:],i+1):
            for pa,pb in pairs:
                if (re.search(pa,norm(a)) and re.search(pb,norm(b))) or \
                   (re.search(pb,norm(a)) and re.search(pa,norm(b))):
                    findings.append((i+1,j+1,a,b))
                    break
    return findings[:20]

