def v9_chunk_text(text, chunk_size=1400, overlap=180):
    text = normalize_text(text)
    if not text:
        return []
    chunks, start, n = [], 0, len(text)
    while start < n:
        end = min(n, start + chunk_size)
        chunk = text[start:end].strip()
        if chunk:
            chunks.append(chunk)
        if end >= n:
            break
        start = max(end - overlap, start + 1)
    return chunks

def v9_build_rag_records(case_id, document_id, text, page_no=0):
    records = []
    for i, chunk in enumerate(v9_chunk_text(text), 1):
        records.append({
            "case_id": case_id,
            "document_id": document_id,
            "chunk_id": f"{case_id}-CH-{i:04d}",
            "page_no": page_no,
