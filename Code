            f"User-cited authority leads: {m['authority_leads']}",
            "",
            "STATUS: RESEARCH SUPPORT — HUMAN VERIFICATION REQUIRED",
            "No metric above represents guilt, liability, confidence, or case outcome.",
        ]
        self.v11_library_text.delete("1.0", "end")
        self.v11_library_text.insert("1.0", "\n".join(lines))

    def v12_research_cockpit_ui(self):
        try:
            if not hasattr(self, "tabs"):
                return
            frame = ttk.Frame(self.tabs)
            self.tabs.add(frame, text="22 Research Cockpit")

            ttk.Label(
                frame, text="Legal Research Cockpit",
                font=("TkDefaultFont", 14, "bold")
            ).pack(anchor="w", padx=12, pady=(12, 4))
            ttk.Label(
                frame,
                text=("Claim ledger + counter-analysis + memorandum outline + local-source retrieval. "
                      "This is a research workspace, not an automated legal decision-maker."),
                wraplength=1050, justify="left"
            ).pack(anchor="w", padx=12, pady=(0, 8))

            bar = ttk.Frame(frame)
            bar.pack(fill="x", padx=12, pady=5)
            ttk.Button(bar, text="Build Session", command=self.v12_build_session).pack(side="left", padx=(0, 6))
            ttk.Button(bar, text="Claim Ledger", command=self.v12_claims).pack(side="left", padx=6)
            ttk.Button(bar, text="Counter-Analysis", command=self.v12_opposition).pack(side="left", padx=6)
            ttk.Button(bar, text="Memo Outline", command=self.v12_outline).pack(side="left", padx=6)
            ttk.Button(bar, text="Save Session", command=self.v12_save_session).pack(side="left", padx=6)

            self.v12_text = tk.Text(frame, wrap="word", height=27)
            self.v12_text.pack(fill="both", expand=True, padx=12, pady=8)
            self.v12_session = None
            self.v12_build_session()
        except Exception:
            pass

    def v12_build_session(self):
        if not hasattr(self, "v12_text"):
            return
        problem = self._get_current_problem() if hasattr(self, "_get_current_problem") else ""
        if not problem:
            self.v12_text.delete("1.0", "end")
            self.v12_text.insert("1.0", "Enter a problem statement first.")
            return
        library = getattr(self, "v11_library", [])
        self.v12_session = v12_build_research_session(problem, library)
        s = self.v12_session
        lines = [
            "RESEARCH SESSION",
            "",
            f"Session ID: {s['session_id']}",
            f"Case ID: {s['case']['case_id']}",
            f"Created: {s['created_at_utc']}",
            "",
            f"Claims: {len(s['claims'])}",
            f"Issues: {len(s['issues'])}",
            f"Research gaps: {len(s['research_gaps'])}",
            f"Local retrieved passages: {len(s['retrieved_local_sources'])}",
            "",
            "STATUS: " + s["safety_status"],
        ]
        self.v12_text.delete("1.0", "end")
        self.v12_text.insert("1.0", "\n".join(lines))

    def v12_claims(self):
        if not self.v12_session:
            self.v12_build_session()
        if hasattr(self, "v12_text") and self.v12_session:
            self.v12_text.delete("1.0", "end")
            self.v12_text.insert("1.0", v12_render_claim_ledger(self.v12_session))

    def v12_opposition(self):
        if not self.v12_session:
            self.v12_build_session()
        if hasattr(self, "v12_text") and self.v12_session:
            self.v12_text.delete("1.0", "end")
            self.v12_text.insert("1.0", v12_render_opposition(self.v12_session))

    def v12_outline(self):
        if not self.v12_session:
            self.v12_build_session()
        if hasattr(self, "v12_text") and self.v12_session:
            self.v12_text.delete("1.0", "end")
            self.v12_text.insert("1.0", v12_render_draft_outline(self.v12_session))

    def v12_save_session(self):
        try:
            if not self.v12_session:
                self.v12_build_session()
            if not self.v12_session:
                return
            path = Path.cwd() / f"LegalMind_{self.v12_session['session_id']}.json"
            path.write_text(json.dumps(self.v12_session, indent=2, ensure_ascii=False), encoding="utf-8")
            if hasattr(self, "v12_text"):
                self.v12_text.insert("end", f"\n\nSaved research session:\n{path}")
        except Exception as e:
            if hasattr(self, "v12_text"):
                self.v12_text.insert("end", f"\n\nSave error: {e}")
