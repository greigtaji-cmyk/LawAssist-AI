def extract_legal_citations(text):
    pat = re.compile(r"\b(?:Section|Sec\.?|S\.)\s*\d+[A-Za-z]?(?:\([^)]+\))?(?:\s+of\s+(?:the\s+)?[A-Z][A-Za-z&.\- ]+(?:Act|Code|Constitution|Rules))?", re.I)
    return sorted(set(m.group(0).strip(" ,.;") for m in pat.finditer(text or "")))
def extract_dates(text):
    pat = re.compile(r"\b(?:\d{1,2}[/-]\d{1,2}[/-]\d{2,4}|\d{1,2}\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\s+\d{4}|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\s+\d{1,2},?\s+\d{4})\b", re.I)
    return sorted(set(m.group(0) for m in pat.finditer(text or "")))
def extract_roles(text):
    roles = {"complainant","petitioner","respondent","accused","victim","witness","employer","employee","buyer","seller","tenant","landlord","borrower","lender","director","company","police","authority","consumer","defendant","plaintiff"}
    low = (text or "").lower()
    return sorted(r for r in roles if re.search(r"\b" + re.escape(r) + r"\b", low))
