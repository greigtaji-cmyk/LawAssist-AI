def build_search_queries(problem, laws, cases):
    p = norm(problem)
    queries = []
    if laws:
        for _, _, law in laws[:6]:
            queries.append(f"{law['act']} {law['section']} {law['title']}")
    if cases:
        for _, _, case in cases[:6]:
            queries.append(f"{case['name']} {case['year']}")
    # Generic issue queries improve discovery when local rules do not match.
    for term in ["ingredients elements", "judgment legal issue", "limitation procedure"]:
        if term not in p:
            queries.append(f"{term} {problem[:120]}")
    return list(dict.fromkeys(queries))

def build_issue_matrix(problem, laws):
    rows = []
    for score, hits, law in laws:
        rows.append({
            "issue": law["title"],
            "law": f"{law['act']} — {law['section']}",
            "relevance": score,
            "facts": ", ".join(hits),
            "verify": "Verify every statutory element, exception and current amendment."
        })
    if not rows:
        rows.append({
            "issue": "Unmapped legal issue",
            "law": "No local match",
            "relevance": 0,
            "facts": "Requires broader legal research",
            "verify": "Search official sources using the facts and legal issues."
        })
    return rows

def evidence_map(problem, laws):
    p = norm(problem)
    items = []
    checks = [
        ("Identity / relationship", "party", ["employer","employee","seller","buyer","husband","wife","tenant","landlord"]),
        ("Communication evidence", "digital", ["whatsapp","email","message","call","instagram","online","sms"]),
        ("Financial evidence", "financial", ["money","payment","paid","loan","transaction","refund","bank","upi"]),
        ("Physical evidence", "physical", ["injury","beaten","hit","damage","broken","assault"]),
        ("Documentary evidence", "document", ["contract","agreement","invoice","notice","receipt","document"]),
        ("Witness evidence", "witness", ["witness","saw","heard","present"]),
    ]
    for label, kind, words in checks:
        found = [w for w in words if w in p]
        items.append((label, "Potentially relevant" if found else "Not established from input",
                      ", ".join(found) if found else "No matching fact detected"))
    return items

def generate_legal_brief(problem, laws, cases, questions, counters, jurisdiction, role):
    now = datetime.now().strftime("%d %B %Y, %I:%M %p")
    lines = [
        "LEGALMIND AI PRO — PRELIMINARY LEGAL RESEARCH BRIEF",
        "=" * 78,
        f"Generated: {now}",
        f"Jurisdiction selected: {jurisdiction}",
        f"User role: {role}",
        "",
        "1. FACTUAL STATEMENT",
        problem,
        "",
        "2. POTENTIALLY RELEVANT LAW",
    ]
    for score, hits, law in laws:
        lines += [
            f"- {law['act']} — {law['section']}: {law['title']}",
            f"  Research relevance: {score}/100 (textual relevance, not probability)",
            f"  Trigger facts: {', '.join(hits)}",
            f"  Why: {law['why']}",
        ]
    if not laws:
        lines.append("- No local database match. Broader official-source research required.")
    lines += ["", "3. PRECEDENT RESEARCH LEADS"]
    for score, hits, case in cases:
        lines += [f"- {case['name']} ({case['year']}) — {case['court']}",
                  f"  Issue tags: {', '.join(hits)}", f"  {case['summary']}"]
    if not cases:
        lines.append("- No local case lead matched.")
    lines += ["", "4. MISSING FACTS / QUESTIONS"]
    for i, q in enumerate(questions, 1):
        lines.append(f"{i}. {q}")
    lines += ["", "5. COUNTER-ANALYSIS"]
    for c in counters:
        lines.append(f"- {c}")
    lines += [
        "",
        "6. VERIFICATION NOTICE",
        "This brief is a research aid. It does not establish that an offence, violation,",
        "liability or defence exists. Verify current legislation, commencement, amendments,",
        "jurisdiction, procedural rules and complete judgments using authoritative sources."
    ]
    return "\n".join(lines)


# -------------------- v6 Case Intelligence Layer --------------------
def classify_fact_status(sentence):
    s = normalize_text(sentence)
    low = s.lower()
    if any(x in low for x in ["alleged", "alleges", "claims", "according to", "reportedly", "said that"]):
        return "ALLEGATION / ATTRIBUTED"
    if any(x in low for x in ["disputed", "denies", "denied", "not true", "incorrect"]):
        return "DISPUTED"
    if any(x in low for x in ["unknown", "unclear", "not known", "not sure", "cannot confirm"]):
        return "UNKNOWN"
    return "STATED FACT — VERIFY"

def build_fact_ledger(problem):
    sentences = [normalize_text(x) for x in re.split(r"(?<=[.!?])\s+", problem or "") if normalize_text(x)]
    ledger = []
    for i, s in enumerate(sentences, 1):
        ledger.append({
            "id": f"F{i:03d}",
            "statement": s,
            "status": classify_fact_status(s),
            "dates": extract_dates(s),
            "roles": extract_roles(s),
            "citations": extract_legal_citations(s),
        })
    return ledger

def build_citation_ledger(problem, laws=None, cases=None):
    laws = laws or []
    cases = cases or []
    rows = []
    for c in extract_legal_citations(problem):
        rows.append({
            "authority": c,
            "type": "USER-CITED PROVISION",
            "source": "India Code",
            "status": authority_status("India Code"),
            "verification_action": "Open current official text and verify section, definitions, commencement and amendments."
        })
    for law in laws:
        name = law.get("name", law.get("title", str(law))) if isinstance(law, dict) else str(law)
        rows.append({
            "authority": name,
            "type": "CANDIDATE LAW",
            "source": "India Code",
            "status": authority_status("India Code"),
            "verification_action": "Confirm that all statutory elements match the confirmed facts."
        })
    for case in cases:
        name = case.get("name", case.get("title", str(case))) if isinstance(case, dict) else str(case)
        rows.append({
            "authority": name,
            "type": "CASE LEAD",
            "source": "Supreme Court",
            "status": authority_status("Supreme Court"),
            "verification_action": "Read the complete judgment and verify the holding/ratio and factual fit."
        })
    # Deduplicate by authority + type.
    seen, out = set(), []
    for row in rows:
        key = (row["authority"], row["type"])
        if key not in seen:
            seen.add(key)
            out.append(row)
    return out

def calculate_case_coverage(problem, laws=None):
    laws = laws or []
    facts = build_fact_ledger(problem)
    fact_count = len(facts)
    citation_count = len(extract_legal_citations(problem))
    law_count = len(laws)
    return {
        "fact_count": fact_count,
        "candidate_law_count": law_count,
        "user_citation_count": citation_count,
        "date_count": len(extract_dates(problem)),
        "role_count": len(extract_roles(problem)),
        "coverage_note": (
            "Coverage counts describe extracted material only; they are not probabilities, "
            "confidence in guilt/liability, or predictions of case outcome."
        ),
    }

def build_counter_questions(problem, laws=None):
    low = (problem or "").lower()
    qs = [
        "What fact, if disproved, would most change the legal analysis?",
        "Which material fact is supported by a document, recording, witness, or other independent evidence?",
        "Is there an innocent or non-liability explanation consistent with the stated facts?",
        "Are any dates, identities, amounts, locations, or communications uncertain or disputed?",
        "Which statutory element currently has the weakest factual support?",
        "Could a procedural, jurisdictional, limitation, or contractual issue change the route of the matter?",
    ]
    if "contract" in low or "agreement" in low:
        qs.append("What exact contractual term, breach, notice, cure period, or termination provision is relied upon?")
    if any(x in low for x in ["money", "payment", "loan", "amount", "refund"]):
        qs.append("What records establish the amount, payment trail, demand, and response?")
    return qs

