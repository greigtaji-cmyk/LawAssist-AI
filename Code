def norm(s):
    return re.sub(r"\s+", " ", re.sub(r"[^a-z0-9\s]", " ", s.lower())).strip()

def hit_terms(text, terms):
    p = norm(text)
    return [t for t in terms if t in p]

def score_law(text, law):
    hits = hit_terms(text, law["tags"])
    # Simple transparent research score, NOT probability of liability.
    score = min(100, 20 + len(hits) * 18)
    return score, hits

def analyze_laws(text):
    rows=[]
    for law in LAW_DB:
        score,hits=score_law(text,law)
        if hits:
            rows.append((score,hits,law))
    return sorted(rows,key=lambda x:x[0],reverse=True)

def analyze_cases(text):
    p=norm(text)
    rows=[]
    for case in CASE_DB:
        hits=[t for t in case["tags"] if t in p]
        if hits:
            rows.append((len(hits),hits,case))
    return sorted(rows,key=lambda x:x[0],reverse=True)

def facts_and_questions(text):
    p=norm(text)
    q=[]
    if not re.search(r"\b(when|on \d|date|month|year|yesterday|today)\b",p):
        q.append("What is the exact date or date range of the incident?")
    if not re.search(r"\b(where|at|in|near|office|home|police station|court)\b",p):
        q.append("Where did the incident occur?")
    if not re.search(r"\b(who|person|accused|defendant|company|employer|seller)\b",p):
        q.append("Who are the people/entities involved and what was each person's role?")
    if any(x in p for x in ["money","payment","paid","loan","transaction","refund"]):
        q.append("What amount was involved and what records prove the payment or promise?")
    if any(x in p for x in ["whatsapp","email","message","instagram","online","account","hacked","data"]):
        q.append("Do you have the original digital evidence, timestamps, URLs, account logs or device records?")
    if any(x in p for x in ["injury","beaten","hit","assault","wound"]):
        q.append("Is there a medical report, photograph, CCTV or independent witness evidence?")
    q += [
        "Was there a contract, written promise, invoice, notice or other document connected to the dispute?",
        "Are there witnesses who directly saw or heard the relevant event?",
        "Has a complaint/FIR/case already been filed? If yes, what section and court/police station?",
        "Is there any connected act that occurred before or after the main incident?",
        "Could any fact support an alternative explanation or defence?"
    ]
    return q

