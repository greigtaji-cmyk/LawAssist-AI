def v7_diff_summary(old_text, new_text):
    old = normalize_text(old_text).split()
    new = normalize_text(new_text).split()
    ratio = difflib.SequenceMatcher(a=old, b=new).ratio()
    return {
        "text_similarity": round(ratio, 3),
        "old_word_count": len(old),
        "new_word_count": len(new),
        "changed": old != new,
        "note": "This is a text-change metric, not a legal-confidence or outcome score.",
    }


