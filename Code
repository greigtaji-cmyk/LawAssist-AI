# -------------------- v11 Local Evidence Library & Research Dashboard --------------------
V11_DOCUMENT_INDEX = "LEGALMIND_LOCAL_INDEX_V11"

def v11_document_fingerprint(path):
    p = Path(path)
    try:
        data = p.read_bytes()
        return hashlib.sha256(data).hexdigest()
    except Exception:
        return hashlib.sha256(str(p).encode("utf-8")).hexdigest()

def v11_extract_plain_file(path):
    p = Path(path)
    suffix = p.suffix.lower()
    if suffix in (".txt", ".md", ".csv", ".json", ".log"):
        return p.read_text(encoding="utf-8", errors="replace")
    # Reuse optional PDF/DOCX extraction functions when present in the v4-v10 code.
    if suffix == ".pdf":
        try:
            from pypdf import PdfReader
            reader = PdfReader(str(p))
            return "\n".join((page.extract_text() or "") for page in reader.pages)
        except Exception as e:
            raise RuntimeError("PDF extraction requires pypdf. " + str(e))
    if suffix == ".docx":
        try:
            from docx import Document
            doc = Document(str(p))
            return "\n".join(par.text for par in doc.paragraphs)
        except Exception as e:
            raise RuntimeError("DOCX extraction requires python-docx. " + str(e))
    raise RuntimeError("Unsupported file type. Use TXT, MD, CSV, JSON, LOG, PDF or DOCX.")

def v11_build_index(path, case_id):
    text = v11_extract_plain_file(path)
    chunks = v9_build_rag_records(case_id, 0, text)
    for ch in chunks:
        ch["document_sha256"] = v11_document_fingerprint(path)
        ch["filename"] = Path(path).name
    return {
        "case_id": case_id,
        "filename": Path(path).name,
        "path": str(Path(path).resolve()),
        "document_sha256": v11_document_fingerprint(path),
        "text_length": len(text),
        "chunk_count": len(chunks),
        "chunks": chunks,
        "created_at": now_utc(),
    }

def v11_search_library(query, library, top_k=10):
    rows = []
    for doc in library or []:
        for ch in doc.get("chunks", []):
            score = v10_tfidf_like_score(query, ch.get("text", ""))
            if score > 0:
                rows.append({
                    "filename": doc.get("filename", ""),
                    "document_sha256": doc.get("document_sha256", ""),
                    "chunk_id": ch.get("chunk_id", ""),
                    "page_no": ch.get("page_no", 0),
                    "score": score,
                    "text": ch.get("text", ""),
                })
    rows.sort(key=lambda x: (-x["score"], x["filename"], x["chunk_id"]))
    return rows[:top_k]

def v11_source_answer_template(question, hits):
    # Produces a source-backed answer scaffold; it intentionally does not invent
    # an answer from the retrieved text.
    return {
        "question": question,
        "retrieved_sources": [
            {
                "rank": i + 1,
                "filename": h["filename"],
                "chunk_id": h["chunk_id"],
                "page_no": h["page_no"],
                "relevance": h["score"],
                "excerpt": h["text"][:900],
                "document_sha256": h["document_sha256"],
            }
            for i, h in enumerate(hits)
        ],
        "answer_policy": (
            "Generate the substantive answer only after reviewing the retrieved source text. "
            "Every legal proposition must cite its supporting source. If the sources are insufficient, "
