            box.delete("1.0","end")
        self.result_data=None

    def analyze(self):
        problem=self.problem.get("1.0","end").strip()
        if len(problem)<30:
            messagebox.showwarning("More detail needed","Enter at least a few sentences describing the facts.")
            return

        laws=analyze_laws(problem)
        cases=analyze_cases(problem)
        semantic_cases=semantic_case_leads(problem)
        questions=facts_and_questions(problem)
        deep_questions=generate_case_questions(problem,laws)
        counters=counter_arguments(problem,[x[2] for x in laws])
        dates=timeline(problem)
        issue_rows=build_issue_matrix(problem,laws)
        evidence_rows=evidence_map(problem,laws)
        queries=build_search_queries(problem,laws,cases)
        limitations=limitation_check(problem)
        entities=extract_entities(problem)
        fact_rows=fact_classification(problem)
        risks=risk_flags(problem)
        indexed=search_index(problem,10)
        contradictions=detect_contradictions(problem)
        element_rows=build_element_checklist(laws)
        theories=build_case_theories(problem,laws)
        gate=verification_gate(self.result_data or {})

        self.laws.delete("1.0","end")
        self.laws.insert("end","POTENTIALLY RELEVANT LAWS & ELEMENTS\n\n")
        for score,hits,law in laws:
            self.laws.insert("end",f"[{issue_priority(score)}] {law['act']} — {law['section']}\n")
            self.laws.insert("end",f"{law['title']}\n")
            self.laws.insert("end",f"Research relevance: {score}/100 (textual relevance only)\n")
            self.laws.insert("end",f"Why it may relate: {law['why']}\n")
            self.laws.insert("end",f"Matched fact signals: {', '.join(hits)}\n")
            self.laws.insert("end","Elements requiring verification:\n")
            for e in law["elements"]: self.laws.insert("end",f"  ☐ {e}\n")
            self.laws.insert("end",f"Official portal: {OFFICIAL_INDIA_CODE}\n\n")

        self.cases.delete("1.0","end")
        self.cases.insert("end","PRECEDENT RESEARCH WORKBENCH\n\n")
        seen=set()
        for sim,c in semantic_cases[:12]:
            seen.add(c["name"])
            self.cases.insert("end",f"CASE: {c['name']} ({c['year']})\n")
            self.cases.insert("end",f"COURT: {c['court']}\n")
            self.cases.insert("end",f"LOCAL TEXT SIMILARITY: {sim:.1f}/100 — research signal only\n")
            self.cases.insert("end",f"{c['summary']}\n")
            self.cases.insert("end",f"VERIFY: {OFFICIAL_SC_SEARCH}\n\n")
        for _,hits,c in cases:
            if c["name"] not in seen:
                self.cases.insert("end",f"CASE: {c['name']} ({c['year']})\n")
                self.cases.insert("end",f"{c['summary']}\nVERIFY: {OFFICIAL_SC_SEARCH}\n\n")

        self.evidence.delete("1.0","end")
        self.evidence.insert("end","EVIDENCE & FACT REVIEW\n\n")
        self.evidence.insert("end","RISK FLAGS\n")
        for x in risks or ["None detected by the local rule set."]:
            self.evidence.insert("end",f"• {x}\n")
        self.evidence.insert("end","\nMISSING FACTS\n")
        for i,q in enumerate(questions,1): self.evidence.insert("end",f"{i}. {q}\n")
        self.evidence.insert("end","\nEVIDENCE MAP\n")
        for label,status,signals in evidence_rows:
            self.evidence.insert("end",f"• {label}: {status}\n  Signals: {signals}\n")
        self.evidence.insert("end","\nPOSSIBLE CONTRADICTIONS / INTERNAL CONSISTENCY CHECK\n")
        if contradictions:
            for a,b,sa,sb in contradictions:
                self.evidence.insert("end",f"• Sentences {a} and {b} may need review:\n  A: {sa}\n  B: {sb}\n")
        else:
            self.evidence.insert("end","• No simple contradiction pattern detected.\n")
        self.evidence.insert("end","\nCOUNTER-ANALYSIS\n")
        for c in counters:self.evidence.insert("end",f"• {c}\n")
        self.evidence.insert("end","\nLIMITATION / COMMENCEMENT\n")
        for x in limitations:self.evidence.insert("end",f"• {x}\n")

        self.theories.delete("1.0","end")
        self.theories.insert("end","LEGAL THEORY WORKBENCH\n\n")
        for t in theories:
            self.theories.insert("end",f"THEORY: {t['theory']}\n")
            self.theories.insert("end",f"PROVISION: {t['provision']}\n")
            self.theories.insert("end",f"FACT SIGNALS: {', '.join(t['supporting_signals'])}\n")
            self.theories.insert("end",f"STATUS: {t['status']}\n\n")
        self.theories.insert("end","ELEMENT CHECKLIST\n\n")
        for e in element_rows:
            self.theories.insert("end",f"☐ {e['law']}\n  Element: {e['element']}\n  Status: {e['status']}\n  Evidence: {e['evidence']}\n\n")

        self.verification.delete("1.0","end")
        self.verification.insert("end","FINAL VERIFICATION GATE\n\n")
        self.verification.insert("end","The report should be treated as RESEARCH DRAFT until every gate is checked by a human.\n\n")
        for i,(label,done) in enumerate(gate,1):
            self.verification.insert("end",f"☐ {i}. {label}\n")
        self.verification.insert("end","\nNo AI-generated authority should be treated as verified merely because it appears in this application.\n")

        self.report.delete("1.0","end")
        self.report.insert("end",generate_legal_brief(
            problem,laws,cases,questions,counters,self.jur.get(),self.role.get()
        ))
        self.report.insert("end",f"\n\nCASE ID: {make_case_id(problem)}\n")
        self.report.insert("end","\nDECISION SUPPORT STATUS: RESEARCH DRAFT — HUMAN VERIFICATION REQUIRED\n")
        self.report.insert("end","\nRESEARCH PRIORITIES\n")
        priorities=[
            "Verify current statutory text, amendments and commencement.",
            "Verify jurisdiction, forum, limitation and procedure.",
            "Read the complete judgments and distinguish material facts.",
            "Map each material allegation to evidence and identify disputed facts.",
            "Review possible counterarguments and alternative explanations.",
            "Verify every citation before using it in a legal document.",
            "Obtain qualified legal review before filing, advising or communicating conclusions."
        ]
        for i,x in enumerate(priorities,1): self.report.insert("end",f"{i}. {x}\n")
        self.report.insert("end",f"\n{confidence_note()}\n")

        self._render_matrix(issue_rows)
        self._render_queries(queries)
        self.questions.delete("1.0","end")
        self.questions.insert("end","FOLLOW-UP QUESTIONS FOR THE NEXT RESEARCH ROUND\n\n")
        for i,q in enumerate(deep_questions,1): self.questions.insert("end",f"{i}. {q}\n")

        self.factmap.delete("1.0","end")
        self.factmap.insert("end","STRUCTURED FACT MAP\n\n")
        for label,key in [("People / named persons","people_or_named_persons"),
                          ("Dates","dates"),("Money mentions","money_mentions"),
                          ("Emails","emails"),("Phones","phones")]:
            self.factmap.insert("end",f"{label}: {', '.join(entities[key]) or 'None detected'}\n")
        self.factmap.insert("end","\nFACT / ALLEGATION CLASSIFICATION\n\n")
        for label,s in fact_rows:self.factmap.insert("end",f"[{label}] {s}\n")

        self.library.delete("1.0","end")
        self.library.insert("end","LOCAL DOCUMENT SIMILARITY RESULTS\n\n")
        for sim,name,path,digest,content in indexed:
            self.library.insert("end",f"{name} — similarity {sim:.1f}/100\nPath: {path}\nSHA-256: {digest}\n\n")
        if not indexed:self.library.insert("end","No previously indexed documents matched.\n")

        self.result_data={
            "case_id":make_case_id(problem),"problem":problem,
            "jurisdiction":self.jur.get(),"role":self.role.get(),
            "laws":[build_authority_record(l) for _,_,l in laws],
            "cases":[build_case_record(c,sim) for sim,c in semantic_cases[:12]],
            "questions":questions,"deep_questions":deep_questions,
            "counter_analysis":counters,"evidence_map":evidence_rows,
            "issue_matrix":issue_rows,"research_queries":queries,
            "limitation_checks":limitations,"entities":entities,
            "fact_classification":fact_rows,"risk_flags":risks,
            "document_matches":[{"name":n,"path":p,"similarity":round(s,2),"sha256":d}
                                for s,n,p,d,_ in indexed],
            "contradictions":contradictions,
            "legal_theories":theories,
            "element_checklist":element_rows,
            "verification_gate":gate,
            "generated_at":datetime.now().isoformat(timespec="seconds")
        }
        save_db("Auto-analysis",problem,self.result_data)
        audit("ANALYZE",self.result_data["case_id"],
              f"{len(laws)} potential laws; {len(semantic_cases[:12])} case leads; {len(contradictions)} consistency flags.")

    def save(self):
        if not self.result_data:
            messagebox.showinfo("Analyze first","Run an analysis before saving.")
            return
        title="Case "+datetime.now().strftime("%Y-%m-%d %H:%M")
        save_db(title,self.result_data["problem"],self.result_data)
        self.load_history()
        audit("SAVE_CASE", self.result_data.get("case_id",""), "Case analysis saved locally.")
        self.load_audit()
        messagebox.showinfo("Saved","Case saved locally.")

    def load_history(self):
        self.history.delete("1.0","end")
        con=sqlite3.connect(DB)
        con.execute("""CREATE TABLE IF NOT EXISTS analyses(
            id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT, title TEXT,
            problem TEXT, result TEXT)""")
        rows=con.execute("SELECT created_at,title,problem FROM analyses ORDER BY id DESC LIMIT 100").fetchall()
        con.commit(); con.close()
        for dt,title,problem in rows:
            self.history.insert("end",f"{dt} | {title}\n{problem[:600]}\n\n")

    def export(self):
        if not self.result_data:
            messagebox.showinfo("Analyze first","Run an analysis before exporting.")
            return
        path=filedialog.asksaveasfilename(defaultextension=".txt",
              filetypes=[("Legal research report","*.txt"),("JSON","*.json"),("CSV","*.csv")])
        if not path:return
        if path.lower().endswith(".json"):
            Path(path).write_text(json.dumps(self.result_data,indent=2,ensure_ascii=False),encoding="utf-8")
        elif path.lower().endswith(".csv"):
            with open(path,"w",newline="",encoding="utf-8") as f:
                w=csv.writer(f); w.writerow(["Type","Value"])
                for k,v in self.result_data.items():w.writerow([k,json.dumps(v,ensure_ascii=False)])
        else:
            with open(path,"w",encoding="utf-8") as f:
                f.write("LEGALMIND AI PRO — LEGAL RESEARCH REPORT\n"+"="*72+"\n\n")
                f.write("Problem:\n"+self.result_data["problem"]+"\n\n")
                f.write("LAWS\n"+self.laws.get("1.0","end")+"\n")
                f.write("CASES\n"+self.cases.get("1.0","end")+"\n")
                f.write("EVIDENCE\n"+self.evidence.get("1.0","end")+"\n")
                f.write("CASE STRUCTURE / BRIEF\n"+self.report.get("1.0","end"))
                f.write("\n\nISSUE MATRIX\n"+self.matrix.get("1.0","end"))
                f.write("\n\nRESEARCH QUERIES\n"+self.queries.get("1.0","end"))
                f.write("\n\nFOLLOW-UP QUESTIONS\n"+self.questions.get("1.0","end"))
                f.write("\n\nFACT MAP\n"+self.factmap.get("1.0","end"))
                f.write("\n\nLOCAL DOCUMENT LIBRARY\n"+self.library.get("1.0","end"))
                f.write("\n\nLEGAL THEORIES\n"+self.theories.get("1.0","end"))
                f.write("\n\nVERIFICATION GATE\n"+self.verification.get("1.0","end"))
        messagebox.showinfo("Exported",f"Report saved to:\n{path}")

