/* ============================================================
   NORMALIZATION
   ============================================================ */

function norm(text){

    return (text || "")
        .toLowerCase()
        .replace(/[^a-z0-9\s₹]/g, " ")
        .replace(/\s+/g, " ")
        .trim();

}


/* ============================================================
   SAFE TERM MATCHING
   ============================================================ */

function hasTerm(text, term){

    const p = norm(text);
    const t = norm(term);

    if(!t){
        return false;
    }

    /*
       For phrases, use contains().
    */

    if(t.includes(" ")){
        return p.includes(t);
    }

    /*
       For single words, use word boundaries.
    */

    const escaped =
        t.replace(
            /[.*+?^${}()|[\]\\]/g,
            "\\$&"
        );

    return new RegExp(
        "\\b" +
        escaped +
        "\\b",
        "i"
    ).test(p);

}


/* ============================================================
   CASE ID
   ============================================================ */

function makeId(text){

    let hash = 2166136261;

    for(
        let i = 0;
        i < text.length;
        i++
    ){

        hash ^= text.charCodeAt(i);

        hash =
            Math.imul(
                hash,
                16777619
            );

    }

    return (
        "LM-" +
        (hash >>> 0)
        .toString(16)
        .toUpperCase()
        .padStart(8,"0")
    );

}


/* ============================================================
   ANALYSIS
   ============================================================ */

function analyze(raw){

    const p = norm(raw);

    const laws = [];
    const cases = [];


    /* --------------------------------------------------------
       LAW MATCHING
       -------------------------------------------------------- */

    LAW_DB.forEach(
        item => {

            const hits =
                item[3].filter(
                    keyword =>
                        hasTerm(
                            raw,
                            keyword
                        )
                );


            if(hits.length){

                laws.push({

                    act: item[0],

                    section: item[1],

                    title: item[2],

                    hits: hits,

                    score:
                        Math.min(
                            100,
                            20 +
                            18 * hits.length
                        )

                });

            }

        }
    );


    laws.sort(
        (a,b) =>
            b.score - a.score
    );


    /* --------------------------------------------------------
       CASE MATCHING
       -------------------------------------------------------- */

    CASES.forEach(
        item => {

            const hits =
                item[3].filter(
                    keyword =>
                        hasTerm(
                            raw,
                            keyword
                        )
                );


            if(hits.length){

                cases.push({

                    name: item[0],

                    year: item[1],

                    topic: item[2],

                    hits: hits,

                    score:
                        Math.min(
                            100,
                            35 +
                            15 * hits.length
                        )

                });

            }

        }
    );


    cases.sort(
        (a,b) =>
            b.score - a.score
    );


    /* --------------------------------------------------------
       EVIDENCE
       -------------------------------------------------------- */

    const evidence = [

        [
            "Chronology / dates",

            /\b\d{1,2}[/-]\d{1,2}[/-]\d{2,4}\b/
            .test(raw)
            ||
            /\b(?:19|20)\d{2}\b/
            .test(raw)
        ],

        [
            "Digital communications",

            [
                "whatsapp",
                "email",
                "message",
                "sms"
            ].some(
                x => hasTerm(raw,x)
            )
        ],

        [
            "Financial records",

            [
                "money",
                "payment",
                "paid",
                "loan",
                "bank",
                "upi",
                "refund"
            ].some(
                x => hasTerm(raw,x)
            )
        ],

        [
            "Contracts / documents",

            [
                "contract",
                "agreement",
                "invoice",
                "notice",
                "receipt"
            ].some(
                x => hasTerm(raw,x)
            )
        ],

        [
            "Witness evidence",

            hasTerm(
                raw,
                "witness"
            )
        ],

        [
            "Medical / physical evidence",

            [
                "injury",
                "medical",
                "hospital",
                "assault"
            ].some(
                x => hasTerm(raw,x)
            )
        ]

    ];


    /* --------------------------------------------------------
       QUESTIONS
       -------------------------------------------------------- */

    const questions = [

        "What is the exact date or date range of the incident?",

        "Where did the incident occur?",

        "Who are the people/entities involved and what was each person's role?",

        "What documents, recordings, messages, witnesses or other evidence support each material fact?",

        "Has a complaint, FIR, notice or case already been filed?",

        "Could any fact support an alternative explanation or defence?",

        "Is there any connected act before or after the main incident that may change the analysis?"

    ];


    if(
        [
            "money",
            "payment",
            "paid",
            "loan",
            "transaction",
            "refund"
        ].some(
            x => hasTerm(raw,x)
        )
    ){

        questions.push(
            "What amount was involved and what records prove the payment or promise?"
        );

    }


    if(
        [
            "whatsapp",
            "email",
            "message",
            "online",
            "account",
            "hacked",
            "data"
        ].some(
            x => hasTerm(raw,x)
        )
    ){

        questions.push(
            "Do you have original digital evidence, timestamps, URLs, logs or device records?"
        );

    }


    /* --------------------------------------------------------
       RESULT
       -------------------------------------------------------- */

    return {

        case_id:
            makeId(p),

        laws:
            laws,

        cases:
            cases,

        evidence:
            evidence,

        questions:
            questions,

        generated:
            new Date()
            .toLocaleString(
                "en-IN"
            ),

        notice:
            "Research support only. Textual matches do not establish that a law was violated. Verify current legislation, commencement, amendments, jurisdiction, procedure, limitation and complete judgments before relying on the output."

    };

}


/* ============================================================
   DISPLAY RESULTS
   ============================================================ */

function render(data){


    /* --------------------------------------------------------
       LAWS
       -------------------------------------------------------- */

    document
        .getElementById("laws")
        .innerHTML =

        data.laws.length

        ?

        data.laws.map(
            law => `

            <div class="card">

                <span class="score">
                    ${law.score}/100
                </span>

                <b>
                    ${law.act}
                    —
                    ${law.section}
                </b>

                <div class="muted">
                    ${law.title}
                </div>

                <p>

                    ${law.hits
                        .map(
                            hit =>
                            `<span class="tag">
                                ${hit}
                            </span>`
                        )
                        .join("")
                    }

                </p>

            </div>

            `
        )
        .join("")

        :

        `
        <div class="empty">
            No local law match.
        </div>
        `;


    /* --------------------------------------------------------
       CASES
       -------------------------------------------------------- */

    document
        .getElementById("cases")
        .innerHTML =

        data.cases.length

        ?

        data.cases.map(
            item => `

            <div class="card">

                <span class="score">
                    ${item.score}/100
                </span>

                <b>
                    ${item.name}
                    (${item.year})
                </b>

                <p class="muted">
                    ${item.topic}
                </p>

                <p>

                    ${item.hits
                        .map(
                            hit =>
                            `<span class="tag">
                                ${hit}
                            </span>`
                        )
                        .join("")
                    }

                </p>

                <a
                    href="https://www.sci.gov.in/judgements-judge/"
                    target="_blank"
                    rel="noopener"
                >
                    Verify judgment ↗
                </a>

            </div>

            `
        )
        .join("")

        :

        `
        <div class="empty">
            No local case lead matched.
        </div>
        `;


    /* --------------------------------------------------------
       EVIDENCE
       -------------------------------------------------------- */

    document
        .getElementById("evidence")
        .innerHTML =

        data.evidence
            .map(
                item => `

                <div class="card">

                    <b>
                        ${item[0]}
                    </b>

                    <div class="muted">

                        ${
                            item[1]

                            ?

                            "Potentially indicated by the input"

                            :

                            "Not established from the input"
                        }

                    </div>

                </div>

                `
            )
            .join("");


    /* --------------------------------------------------------
       QUESTIONS
       -------------------------------------------------------- */

    document
        .getElementById("questions")
        .innerHTML =

        data.questions
            .map(
                (question,index) => `

                <div class="card">

                    <b>
                        ${index + 1}.
                    </b>

                    ${question}

                </div>

                `
            )
            .join("");


    /* --------------------------------------------------------
       SUMMARY
       -------------------------------------------------------- */

    document
        .getElementById("summary")
        .innerHTML = `

        <p>

            <b>
                Case ID:
            </b>

            ${data.case_id}

        </p>


        <p>

            <b>
                Generated:
            </b>

            ${data.generated}

        </p>


        <p>

            <b>
                Status:
            </b>

            HUMAN VERIFICATION REQUIRED

        </p>


        <div class="notice">

            ${data.notice}

        </div>

        `;

}


/* ============================================================
   RUN ANALYSIS
   ============================================================ */

function run(){

    const problem =
        document
            .getElementById(
                "problem"
            )
            .value
            .trim();


    const status =
        document
            .getElementById(
                "status"
            );


    if(
        problem.length < 30
    ){

        status.textContent =
            "Enter at least 30 characters of factual detail.";

        return;

    }


    status.textContent =
        "Analyzing locally...";


    try{

        const result =
            analyze(problem);


        render(result);


        status.textContent =
            "Analysis complete • no server required";


        document
            .getElementById(
                "results"
            )
            .scrollIntoView({

                behavior:"smooth",

                block:"start"

            });

    }

    catch(error){

        console.error(
            error
        );

        status.textContent =
            "Analysis failed. Please refresh the page and try again.";

    }

}


/* ============================================================
   DEMO
   ============================================================ */

function demo(){

    document
        .getElementById(
            "problem"
        )
        .value =

        "On 12/05/2025, a person paid ₹50,000 to a seller after receiving a false promise that a service would be delivered. The seller stopped responding on WhatsApp and refused a refund. The buyer has bank and message records.";

    run();

}


/* ============================================================
   CLEAR
   ============================================================ */

function clearAll(){

    document
        .getElementById(
            "problem"
        )
        .value = "";


    [
        "laws",
        "cases",
        "evidence",
        "questions",
        "summary"
    ]
    .forEach(
        id => {

            document
                .getElementById(
                    id
                )
                .innerHTML =

                `
                <div class="empty">
                    Run an analysis to see results.
                </div>
                `;

        }
    );


    document
        .getElementById(
            "status"
        )
        .textContent = "";

}


/* ============================================================
   SELF TEST
   ============================================================ */

function selfTest(){

    const sample =
        "On 12/05/2025, a seller took ₹50000 after a false promise. The seller stopped replying on WhatsApp and refused a refund. The buyer has bank records and messages.";


    const result =
        analyze(sample);


    const passed =

        result.case_id &&

        result.laws.length > 0 &&

        result.evidence.some(
            item => item[1]
        ) &&

        result.questions.length > 0;


    alert(

        passed

        ?

        "LegalMind AI self-test: PASS"

        :

        "LegalMind AI self-test: FAIL"

    );

}


/* ============================================================
   CTRL + ENTER
   ============================================================ */

document
    .getElementById(
        "problem"
    )
    .addEventListener(
        "keydown",
        event => {

            if(
                (event.ctrlKey ||
                 event.metaKey) &&

                event.key === "Enter"
            ){

                event.preventDefault();

                run();

            }

        }
    );

</script>


